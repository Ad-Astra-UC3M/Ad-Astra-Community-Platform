# Neon PostgreSQL (pooled connection for application runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/Ad_Astra_Community_DB?sslmode=require"

# Neon PostgreSQL (direct unpooled connection for Drizzle migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/Ad_Astra_Community_DB?sslmode=require"

# Neon Auth endpoint for this project/branch
NEON_AUTH_BASE_URL="https://ep-example.neonauth.eu-central-1.aws.neon.tech/Ad_Astra_Community_DB/auth"

# Secret used by @neondatabase/auth/next/server to sign/encrypt session cookies (32+ random bytes)
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-bytes-of-random-hex"

# Dedicated HMAC-SHA256 secret for QR attendance tokens (RF-12, 32+ random bytes)
ATTENDANCE_QR_SECRET="replace-with-at-least-32-bytes-of-random-hex"

# Canonical application origin (used for links and QR JWT audience)
APP_ORIGIN="http://127.0.0.1:3000"
